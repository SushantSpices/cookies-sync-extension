{
  "name": "Providhy Extension",
  "version": "1.0",
  "manifest_version": 3,
  "description": "A Chrome extension for syncing cookies between domains via an interface.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*/*" 
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Providhy Extension"
  },
  "background": {
    "service_worker": "background.js"
  }
}
