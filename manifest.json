{
    "name": "Cookie Sync Extension",
    "version": "1.0",
    "manifest_version": 3,
    "description": "Sync cookies from uat-tenant.providhy.com to localhost",
    "permissions": [
      "cookies",
      "storage"
    ],
    "host_permissions": [
      "*://uat-tenant.providhy.com/*",
      "http://localhost/*",
      "https://localhost/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Sync Cookies"
    }
  }
  